PRODUCTION=false
## gin mode (-gin-mode)
PORT=8095
HOST=localhost
ENVIRONMENT=local
PG_LOG_LEVEL=debug


## JAEGER
JAEGER_SERVICE_NAME=
JAEGER_SAMPLER_TYPE="const"
JAEGER_SAMPLER_PARAM=0.5
JAEGER_AGENT_HOST=
# JAEGER_AGENT_PORT=


#Postgresql
PG_URL = "host= user= password= dbname= port=5432 sslmode=disable"

# ----------- PROMETHEUS-----------
PROM_ENABLE = true
PROM_SERVICE_NAME = ads_noti
#Modes includes:
# expose_metrics: service will save metrics(time series data) and expose a port that prometheus could scrape with interval time
# push_gateway: service will push metrics to prometheus pushgateway with interval time
PROM_MODE: expose_metrics
PROM_METRICS_PORT: 8091

## Redis Client
REDIS_SINGLE_MODE=false
REDIS_URL =  ## For Local

## websocket
WEBSOCKET_SECRET_KEY = 
KAFKA_INIT_TOPIC=true
KAFKA_BROKERS=
KAFKA_POOL_SIZE=10
KAFKA_PATITION=10
KAFKA_REPLICATION=2
KAFKA_PARTITION_AUTO=1

## Kafka client group id
KAFKA_GROUP_ID="canh_test1"
## Kafka retry and DLQ.
KAFKA_RETRY_ATTEMPTS=3
KAFKA_RETRY_DELAYS=5
KAFKA_PUSH_FAILED_TO_DLQ=true
KAFKA_DLQ_MESSAGE_KEY="DLQ"
## kafka topic notification
KAFKA_TOPIC_NOTIFICATION=
KAFKA_TOPIC_NOTIFICATION_DLQ=

